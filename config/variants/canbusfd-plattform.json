{
  "$schema": "../schema.json",
  "extends": "./base.json",
  "variant": {
    "name": "canbusfd-plattform",
    "description": "BAUER GROUP CANbus FD plattform - base image + Waveshare 17075 2-CH isolated CAN FD HAT (2x MCP2518FD, mode A: CAN_0 on SPI0, CAN_1 on SPI1)"
  },
  "hostname": "bg-canbusfd",
  "users": [
    {
      "name": "admin",
      "password": "${ADMIN_PASSWORD:-12345678}",
      "groups": ["dialout", "gpio", "i2c", "spi"],
      "shell": "/bin/bash",
      "sudo_nopasswd": true
    }
  ],
  "packages": ["can-utils"],
  "boot_config": {
    "core_freq_fixed": true,
    "enable_spi": true,
    "dtoverlays": [
      { "name": "spi1-3cs" },
      { "id": "canfd0", "name": "mcp251xfd", "params": { "spi0-0": true, "interrupt": "25", "oscillator": "40000000", "speed": "20000000" } },
      { "id": "canfd1", "name": "mcp251xfd", "params": { "spi1-0": true, "interrupt": "24", "oscillator": "40000000", "speed": "20000000" } }
    ]
  },
  "can": {
    "interfaces": [
      { "name": "can0", "bitrate": 500000, "dbitrate": 2000000, "auto_up": true, "txqueuelen": 1024, "restart_ms": 100 },
      { "name": "can1", "bitrate": 500000, "dbitrate": 2000000, "auto_up": true, "txqueuelen": 1024, "restart_ms": 100 }
    ]
  },
  "watchdog": {
    "enabled": true,
    "runtime_sec": 15,
    "reboot_sec": 600
  }
}
