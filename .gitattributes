# Line endings are a correctness matter in this repo, not a style preference.
#
# scripts/build.sh bind-mounts the working tree straight into the privileged
# build container (`MOUNT_ARGS=(--volume "$ROOT:$ROOT")`), and CustomPiOS then
# copies those bytes into the rootfs verbatim. The bytes on a developer's disk
# are the bytes that ship. This project is developed on Windows, where a
# global core.autocrlf=true rewrites every tracked text file to CRLF on
# checkout - which ships `#!/usr/bin/env bash\r` and fails at exec time with
# "bad interpreter: No such file or directory". To the operator that reads as
# "the command does not exist".
#
# CI builds on ubuntu-latest where autocrlf is unset, so released images were
# never affected; this protects locally built images, a path the repo
# explicitly supports via tools/run.cmd and tools/run.ps1.

* text=auto eol=lf

# Windows-only launchers must stay CRLF: cmd.exe seeks batch files by byte
# offset, so an LF-only .cmd can mis-execute its own goto labels.
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Extensionless files that are shell scripts or shell-sourced config and end
# up inside the image. Covered by the default above, spelled out because these
# are precisely the files that fail silently.
src/modules/*/start_chroot_script text eol=lf
src/modules/*/config              text eol=lf
src/variants/*/config             text eol=lf
src/build_dist                    text eol=lf
src/config                        text eol=lf

*.png binary
*.img binary
*.xz  binary
