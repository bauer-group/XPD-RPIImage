#!/usr/bin/env bash
# bgrpiimage-setup - on-device helper for the most common post-flash changes.
# Installed at /usr/local/sbin/bgrpiimage-setup. Always run with sudo.
#
# Subcommands:
#   password [USER]                        change a user's password (default: admin)
#   wifi enable SSID [PSK] [COUNTRY]       unblock the radio and join a network
#   wifi disable                           tear wifi down and drop its stored PSK
#   wifi status                            rfkill state, regulatory domain, link
#   can status                             per interface: chip select, IRQ, bitrate
#   can bitrate IFACE BPS                  change a CAN bitrate (persistent)
#   can txqueuelen IFACE LEN               change a CAN tx queue length (persistent)
#   ip IFACE dhcp                          switch an interface to DHCP
#   ip IFACE static CIDR [GATEWAY] [DNS]   assign a static IPv4 (CIDR = addr/prefix)
#   status                                 show current network + identity
#
# Images ship with WiFi off: no wlan0 .network file, no wpa_supplicant config.
# "wifi enable" creates both and lifts the rfkill soft block that Raspberry Pi
# OS applies to every radio until a regulatory domain is set. Bluetooth is
# unblocked by the image itself and is not touched by these commands.
#
# Network changes are written as a separate .network file that sorts before
# the image defaults, so they win without those defaults being edited or
# removed. Delete that file to fall back to the shipped configuration.
set -euo pipefail

PROG="${0##*/}"
[[ "$EUID" -eq 0 ]] || { echo "$PROG must run as root (use sudo)" >&2; exit 1; }

CY=$'\033[1;36m'; GR=$'\033[1;32m'; YE=$'\033[1;33m'; RD=$'\033[1;31m'; NC=$'\033[0m'
[[ -t 1 ]] || { CY=''; GR=''; YE=''; RD=''; NC=''; }

RFKILL_CONF=/etc/modprobe.d/zz-bgrpiimage-rfkill.conf
WPA_CONF=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
MARKER=/etc/bgrpiimage-default-password-active

info()  { echo "${CY}[*]${NC} $*"; }
ok()    { echo "${GR}[+]${NC} $*"; }
warn()  { echo "${YE}[!]${NC} $*" >&2; }
die()   { echo "${RD}[x]${NC} $*" >&2; exit 1; }

usage() {
    # Print the leading comment block instead of a hardcoded line range. The
    # previous `sed -n '2,18p'` silently truncated the help text every time a
    # subcommand was documented below line 18.
    awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"
    exit "${1:-0}"
}

# --------------------------------------------------------------------------
cmd_password() {
    local user="${1:-admin}"
    id -u "$user" >/dev/null 2>&1 || die "user '$user' does not exist"
    info "Changing password for '$user'"
    passwd "$user"
    # Clear only THIS user's marker line. Removing the whole file silenced the
    # MOTD warning for every other account that still carried a default.
    if [[ -f "$MARKER" ]]; then
        sed -i "/^${user}:/d; /^${user}$/d" "$MARKER"
        [[ -s "$MARKER" ]] || rm -f "$MARKER"
    fi
    ok "password updated for $user"
}

# --------------------------------------------------------------------------
# Raspberry Pi OS soft-blocks EVERY radio at rfkill module init, through
# /etc/modprobe.d/rfkill_default.conf (options rfkill default_state=0), until a
# WLAN regulatory domain is configured. wpa_supplicant's own country= cannot
# lift it: "ip link set wlan0 up" returns -ERFKILL before wpa_supplicant ever
# gets to send a regulatory hint.
wifi_unblock() {
    local country="$1" f
    install -d /etc/modprobe.d
    cat > "$RFKILL_CONF" <<EOF
# bgRPIImage - overrides raspberrypi-sys-mods' rfkill_default.conf, which is a
# dpkg conffile and must not be edited in place. modprobe reads this directory
# in lexicographic order and the kernel keeps the last value, hence the zz-.
options rfkill default_state=1
options cfg80211 ieee80211_regdom=$country
EOF
    chmod 644 "$RFKILL_CONF"
    if command -v rfkill >/dev/null 2>&1; then
        rfkill unblock wifi || true
    fi
    # systemd-rfkill restores a saved block on the next boot. Clear WLAN only:
    # the *:bluetooth entries are pi-gen's Bluetooth whitelist against
    # default_state=0, and deleting those soft-blocks Bluetooth on CM4.
    for f in /var/lib/systemd/rfkill/*:wlan; do
        if [[ -e "$f" ]]; then echo 0 > "$f"; fi
    done
    iw reg set "$country" 2>/dev/null || true
}

wifi_enable() {
    local ssid="${1:-}" psk="${2:-}" country="${3:-DE}"
    [[ -n "$ssid" ]] || die "usage: $PROG wifi enable SSID [PSK] [COUNTRY]"
    # The country lands verbatim in a 0644 file under /etc/modprobe.d. The
    # pre-0.6.0 back-compat form shifts the arguments by one, so a stray
    # `wifi enable MyNet DE` put "DE" where the PSK belongs - and the mirror
    # slip wrote the PSK itself into that world-readable file in cleartext.
    # Rejecting anything that is not a 2-letter code closes both directions.
    [[ "$country" =~ ^[A-Za-z]{2}$ ]] || die "country must be a 2-letter ISO 3166-1 code, e.g. DE"
    country="${country^^}"
    if [[ -z "$psk" ]]; then
        # Without the tty check the read simply fails on a closed stdin (ssh
        # without -t, an Ansible task, a first-boot script) and set -e killed
        # the script with no message at all - which also made the old
        # "empty password" die unreachable.
        [[ -t 0 ]] || die "no PSK given and stdin is not a terminal - pass it as an argument"
        read -r -s -p "WiFi password for \"$ssid\": " psk || true; echo
    fi
    # wpa_passphrase enforces 8..63 characters and exits non-zero otherwise.
    # Under set -e that killed the script inside the { } block below - after
    # wifi_unblock had already rewritten the rfkill override, leaving a
    # truncated $WPA_CONF.tmp behind with no error and no cleanup.
    (( ${#psk} >= 8 && ${#psk} <= 63 )) || die "WiFi PSK must be 8-63 characters (got ${#psk})"

    info "Lifting the rfkill soft block (regulatory domain $country)"
    wifi_unblock "$country"

    info "Writing $WPA_CONF"
    install -d -m 755 /etc/wpa_supplicant
    {
        echo "ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev"
        echo "update_config=1"
        echo "country=$country"
        echo
        # wpa_passphrase hashes the PSK; drop its plaintext comment line.
        wpa_passphrase "$ssid" "$psk" | grep -v '^[[:space:]]*#psk='
    } > "$WPA_CONF.tmp"
    install -m 600 "$WPA_CONF.tmp" "$WPA_CONF"
    rm -f "$WPA_CONF.tmp"

    # RequiredForOnline=no is load bearing: without it a wlan0 that cannot
    # associate blocks systemd-networkd-wait-online, and docker.service plus
    # the Portainer first-boot install queue behind network-online.target.
    local dropin="/etc/systemd/network/05-bgrpiimage-wlan0.network"
    info "Writing $dropin"
    cat > "$dropin" <<'EOF'
# Auto-generated by bgrpiimage-setup - remove to hand wlan0 back to the image.
[Match]
Name=wlan0

[Network]
DHCP=ipv4
IPv6AcceptRA=yes
LinkLocalAddressing=ipv6

[Link]
RequiredForOnline=no
EOF
    chmod 644 "$dropin"

    systemctl enable "wpa_supplicant@wlan0.service" >/dev/null 2>&1 || true
    systemctl restart "wpa_supplicant@wlan0.service"
    networkctl reload 2>/dev/null || systemctl restart systemd-networkd
    ok "wifi enabled (SSID=$ssid, country=$country)"
    info "check with: $PROG wifi status"
}

wifi_disable() {
    info "Disabling wlan0"
    systemctl disable --now "wpa_supplicant@wlan0.service" 2>/dev/null || true
    rm -f "$WPA_CONF" /etc/systemd/network/05-bgrpiimage-wlan0.network
    networkctl reload 2>/dev/null || systemctl restart systemd-networkd
    ip link set wlan0 down 2>/dev/null || true
    ok "wlan0 down; wpa_supplicant config and stored PSK removed"
    if [[ -f /etc/systemd/network/20-wlan.network ]]; then
        warn "image default /etc/systemd/network/20-wlan.network is still present"
        warn "  (pre-0.6.0 image) - delete it to make wlan0 fully unmanaged"
    fi
    info "Bluetooth is unaffected; the rfkill override stays in place"
}

wifi_status() {
    echo "${CY}rfkill:${NC}"
    rfkill list 2>/dev/null | sed 's|^|  |' || echo "  (rfkill not available)"
    echo "${CY}regulatory domain:${NC}"
    iw reg get 2>/dev/null | sed -n '1,3p' | sed 's|^|  |' || echo "  (unknown)"
    echo "${CY}rfkill default_state:${NC} $(cat /sys/module/rfkill/parameters/default_state 2>/dev/null || echo '?')"
    echo "${CY}wpa_supplicant@wlan0:${NC} $(svc_state wpa_supplicant@wlan0.service)"
    echo "${CY}link:${NC}"
    ip -br addr show wlan0 2>/dev/null | sed 's|^|  |' || echo "  (no wlan0)"
}

cmd_wifi() {
    case "${1:-status}" in
        enable)            shift; wifi_enable "$@" ;;
        disable|--disable) wifi_disable ;;
        status)            wifi_status ;;
        -h|--help)         usage 0 ;;
        # Guard the back-compat form below against near-miss verbs: `wifi statu`
        # was read as an SSID, so a typo silently prompted for a password and
        # then overwrote working credentials instead of printing an error.
        en*|dis*|stat*|-*) die "unknown wifi subcommand '${1}' (expected: enable | disable | status)" ;;
        # Back-compat with the pre-0.6.0 form: wifi SSID [PSK] [COUNTRY].
        *)                 wifi_enable "$@" ;;
    esac
}

# --------------------------------------------------------------------------
# The mcp251x driver names netdevs "can%d" in probe order, so the interface
# number says nothing about which physical connector it is - the chip select
# does, and can0 must resolve to spi0.0. The IRQ is registered under
# dev_name(&spi->dev), i.e. "spi0.0", never "mcp251x", and only from ndo_open,
# so a link that is down shows no IRQ line at all.
# ARPHRD_CAN is 280 (include/uapi/linux/if_arp.h). Every `ip link show IFACE`
# existence check below passes just as happily for eth0 as for can0, and each of
# these commands then writes a 05- file that REPLACES the image default for that
# interface rather than amending it. So `can bitrate eth0` swapped eth0's DHCP
# config for an inert [CAN] section - taking the operator's own SSH session with
# it and still exiting 0 - and `ip can0 dhcp` did the mirror image, dropping
# BitRate= and RestartSec= and leaving the bus dead at the next reboot. Match on
# the netdev type rather than the name: the name comes from probe order and an
# operator can rename either one.
# networkd parses Address=, Gateway= and DNS= itself and REFUSES the whole file
# when any value is malformed - it logs to the journal and carries on, so the
# interface silently ends up with no address while this script prints its green
# success line and exits 0. The old guard matched only the SHAPE of a CIDR, so
# 192.168.1.300/24 and a /64 prefix both sailed through. Validate the values
# here, at the only point where refusing still costs the operator nothing.
# 10#$o forces base 10: a padded octet like 010 would otherwise be read as
# octal, and 08 or 09 are not valid octal at all and abort the arithmetic.
is_ipv4() {
    local o
    [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
    for o in ${1//./ }; do (( 10#$o <= 255 )) || return 1; done
}

is_ipv4_cidr() {
    local addr="${1%%/*}" prefix="${1#*/}"
    [[ "$1" == */* ]] || return 1
    [[ "$prefix" =~ ^[0-9]{1,2}$ ]] && (( 10#$prefix <= 32 )) || return 1
    is_ipv4 "$addr"
}

is_can_iface() {
    [[ "$(cat "/sys/class/net/${1}/type" 2>/dev/null)" == "280" ]]
}

# wlan0 must carry RequiredForOnline=no or a radio that cannot associate holds
# network-online.target until it times out, with docker.service and the
# Portainer first-boot install queued behind it (see wifi_enable). Wired links
# keep the shipped 10-eth.network value of "degraded" instead, so a cable that
# is up but has no lease still satisfies the target.
required_for_online() {
    if [[ -e "/sys/class/net/${1}/phy80211" || -d "/sys/class/net/${1}/wireless" ]]; then
        echo no
    else
        echo degraded
    fi
}

can_status() {
    local iface cs irq_line gpio trig count rate state qlen found=0
    for iface in $(ls /sys/class/net 2>/dev/null | grep '^can[0-9]' | sort); do
        found=1
        cs=$(basename "$(readlink -f "/sys/class/net/$iface/device" 2>/dev/null)" 2>/dev/null)
        [[ -n "$cs" ]] || cs="?"
        irq_line=$(awk -v d="$cs" '$NF==d {
            n=0; for (i=2; i<=NF-4; i++) n+=$i;
            print $(NF-2), $(NF-1), n; exit
        }' /proc/interrupts 2>/dev/null)
        if [[ -n "$irq_line" ]]; then
            gpio=$(echo "$irq_line" | awk '{print $1}')
            trig=$(echo "$irq_line" | awk '{print $2}')
            count=$(echo "$irq_line" | awk '{print $3}')
        else
            gpio="-"; trig="-"; count="-"
        fi
        # `|| true` is load bearing. grep exits 1 when the link carries no
        # bittiming - a STOPPED interface, or one systemd-networkd never
        # applied 40-<iface>.network to. `set -o pipefail` promotes that to
        # the pipeline status, and because `rate` is declared by the `local`
        # above this is a plain assignment, so the status is the assignment's
        # and `set -e` kills the whole process. The result was that `can
        # status` printed NOTHING and exited 1 in precisely the situation it
        # exists to diagnose, which made the "(down)" branch below dead code.
        rate=$(ip -details link show "$iface" 2>/dev/null | grep -oE 'bitrate [0-9]+' | awk '{print $2}' || true)
        if [[ -n "$rate" ]]; then rate="$((rate / 1000)) kbit/s"; else rate="(down)"; fi
        state=$(ip -br link show "$iface" 2>/dev/null | awk '{print $2}')
        qlen=$(cat "/sys/class/net/$iface/tx_queue_len" 2>/dev/null || echo "?")
        printf "  %-6s %-8s gpio %-4s %-6s irq %-12s %-12s %-9s txq %s\n" \
            "$iface" "$cs" "$gpio" "$trig" "$count" "$rate" "${state:-?}" "$qlen"
        # Two traps, both of which hid exactly what this command exists to show.
        # (a) iproute2 emits the "re-started bus-errors ..." COLUMN HEADER and
        # the six counters as SEPARATE lines, so a plain line grep printed the
        # header and dropped every number. Since v0.7.3 ships restart-ms 100 a
        # bus-off now recovers silently, which makes re-started the only
        # evidence a bus is flapping. (b) the ctrlmode list is printed BEFORE
        # the state, so with listen-only or berr-reporting set the line reads
        # "can <BERR-REPORTING> state ..." and a literal 'can state' match
        # dropped the whole line - including the restart-ms that the footer
        # below and both docs pages promise. Match 'can .*state' so another
        # future token cannot break it again.
        # awk rather than grep -A1: -A1 would also drag in the line after the
        # state match and insert literal "--" group separators, and awk exits 0
        # on no match, so it cannot trip the pipefail trap described above.
        # iproute2 indents the counter block with a tab; expand it or the
        # numbers do not line up under the state line.
        ip -details -statistics link show "$iface" 2>/dev/null | awk '
            /^[ \t]*can .*state /               { print; next }
            /^[ \t]*re-started[ \t]+bus-errors/ { print; if ((getline v) > 0) print v; next }
        ' | sed 's|\t|  |g; s|^ *|         |' || true
    done
    if [[ "$found" -eq 0 ]]; then
        echo "  (no CAN interfaces)"
        return 0
    fi
    echo
    echo "  ${CY}expected:${NC} can0 -> spi0.0, can1 -> spi0.1"
    echo "  A txq of 10 is the CAN core default from can_setup() - it means the"
    echo "  70-<iface>.link file never reached udev. TransmitQueueLength is a"
    echo "  .link key; in a .network file it is parsed, logged and discarded."
    echo "  An idle IRQ counter that keeps climbing means the overlay points at a"
    echo "  GPIO the HAT does not drive; a counter stuck at 0 while traffic flows"
    echo "  means it points at the other chip."
    echo "  ${CY}restart-ms${NC} on the 'can state' line is bus-off auto-recovery. A 0"
    echo "  means OFF: on a bus-off the MCP2515 is put to sleep and stays off the"
    echo "  bus until the link is cycled by hand. The image ships 100 - a 0 on a"
    echo "  v0.7.3+ image means a 05-*.network drop-in replaced 40-<iface>.network."
}

can_bitrate() {
    local iface="${1:-}" bps="${2:-}"
    [[ -n "$iface" && -n "$bps" ]] || die "usage: $PROG can bitrate IFACE BPS"
    [[ "$bps" =~ ^[0-9]+$ ]] || die "bitrate must be bit/s as a number, e.g. 250000"
    ip link show "$iface" >/dev/null 2>&1 || die "interface '$iface' does not exist"
    is_can_iface "$iface" || die "'$iface' is not a CAN interface - this would replace its network config (try: $PROG can status)"

    # Queue length is deliberately NOT written here. It is a .link key owned
    # by udev (see can_txqueuelen); this used to read the live tx_queue_len
    # back out of sysfs and re-persist it, which could only ever freeze
    # whatever was already in effect - including the broken default of 10.
    # RestartSec is repeated here on purpose, and dropping it is a silent
    # regression rather than a cosmetic one. A 05- .network file does not merge
    # with the shipped 40-<iface>.network: networkd applies the FIRST matching
    # .network in alphanumeric order and ignores every later one, so this file
    # REPLACES the image default instead of amending it. Writing only BitRate=
    # would therefore switch bus-off auto-recovery back off on exactly the
    # interface an operator just touched - and invisibly, because the kernel
    # keeps the running restart_ms until the next reboot. The "ms" suffix is
    # mandatory: networkd parses RestartSec= in SECONDS by default, so a bare
    # 100 would mean 100 s. Keep the value in sync with CAN_RESTART_MS_DEFAULT
    # in scripts/generate.py.
    local dropin="/etc/systemd/network/05-bgrpiimage-${iface}.network"
    info "Writing $dropin"
    cat > "$dropin" <<EOF
# Auto-generated by bgrpiimage-setup - remove to fall back to the image default.
[Match]
Name=$iface

[CAN]
BitRate=$bps
RestartSec=100ms

[Link]
RequiredForOnline=no
EOF
    chmod 644 "$dropin"
    networkctl reload
    # A CAN bitrate can only be set while the link is down; networkd does that
    # itself on reconfigure. Reboot if the interface refuses to come back up.
    networkctl reconfigure "$iface" 2>/dev/null || systemctl restart systemd-networkd
    # networkd logs a rejected bittiming to the journal and still reports a
    # successful reconfigure, so an impossible rate - 2 Mbit/s on the shipped
    # 8 MHz MCP2515, say - left the link DOWN while this printed success and
    # exited 0. Read the value back rather than assuming it took. The link
    # comes back asynchronously, hence the bounded poll instead of a sleep.
    local live=""
    for _ in 1 2 3 4 5; do
        live=$(ip -details link show "$iface" 2>/dev/null \
               | grep -oE 'bitrate [0-9]+' | awk '{print $2}' || true)
        [[ "$live" == "$bps" ]] && break
        sleep 0.3
    done
    if [[ "$live" == "$bps" ]]; then
        ok "$iface bitrate set to $bps bit/s"
    else
        warn "$iface reports bitrate '${live:-none}' after applying $bps"
        warn "  the controller likely rejected it (see: journalctl -u systemd-networkd -n 20)"
        # Name the file: it is already written and will be applied again at the
        # next boot, so leaving without saying how to revert would strand the
        # bus on a rate the controller cannot do.
        die  "  $dropin still holds $bps - remove it to fall back to the image default"
    fi
    info "verify with: $PROG can status"
}

# TransmitQueueLength is a .link key, applied by systemd-udevd when the netdev
# appears - systemd-networkd never looks at it, so it cannot live in the
# .network drop-in above. The image ships 70-<iface>.link; a 05- prefix sorts
# ahead of that and the FIRST matching .link file wins, mirroring the .network
# override convention used elsewhere in this script.
can_txqueuelen() {
    local iface="${1:-}" len="${2:-}"
    [[ -n "$iface" && -n "$len" ]] || die "usage: $PROG can txqueuelen IFACE LEN"
    # systemd accepts 0-4294967294; cap the digit count first so the shell
    # arithmetic below cannot overflow on absurd input.
    [[ "$len" =~ ^[0-9]+$ && ${#len} -le 10 ]] && (( len <= 4294967294 )) \
        || die "txqueuelen must be an integer in 0-4294967294"
    # Strip padding to base 10. A pasted "0500000" passed the regex and was
    # written verbatim into the .link file while `ip link set` read it as
    # octal, so the persisted value and the live one silently disagreed.
    len=$((10#$len))
    ip link show "$iface" >/dev/null 2>&1 || die "interface '$iface' does not exist"
    is_can_iface "$iface" || die "'$iface' is not a CAN interface - this would shadow its .link defaults (try: $PROG can status)"

    local dropin="/etc/systemd/network/05-bgrpiimage-${iface}.link"
    info "Writing $dropin"
    cat > "$dropin" <<EOF
# Auto-generated by bgrpiimage-setup - remove to fall back to the image default.
[Match]
OriginalName=$iface

[Link]
TransmitQueueLength=$len
EOF
    chmod 644 "$dropin"
    # udev reads .link files only on a netdev "add" event, so the file alone
    # changes nothing until the next boot. Reload for later, then set the live
    # link directly - IFLA_TXQLEN can be written while the interface is up.
    udevadm control --reload
    ip link set dev "$iface" txqueuelen "$len"
    ok "$iface txqueuelen set to $len (now and on every boot)"
    info "verify with: $PROG can status"
}

cmd_can() {
    case "${1:-status}" in
        status)     can_status ;;
        bitrate)    shift; can_bitrate "$@" ;;
        txqueuelen) shift; can_txqueuelen "$@" ;;
        -h|--help)  usage 0 ;;
        *)          die "unknown can subcommand '${1}' (expected: status | bitrate | txqueuelen)" ;;
    esac
}

# --------------------------------------------------------------------------
cmd_ip() {
    local iface="${1:-}" mode="${2:-}"
    [[ -n "$iface" && -n "$mode" ]] || die "usage: $PROG ip IFACE {dhcp|static CIDR [GW] [DNS]}"
    ip link show "$iface" >/dev/null 2>&1 || die "interface '$iface' does not exist"
    ! is_can_iface "$iface" || die "'$iface' is a CAN interface and carries no IP - use '$PROG can bitrate' (this would drop its BitRate and RestartSec)"

    # Must sort BEFORE the image defaults (10-eth.network, 20-wlan.network):
    # systemd-networkd applies only the FIRST .network file whose [Match]
    # matches, in lexicographic order. A 50- prefix loses to 10-/20- and is
    # silently ignored for exactly the interfaces this command targets.
    local dropin="/etc/systemd/network/05-bgrpiimage-${iface}.network"
    # This file REPLACES whatever matched before it, so it has to carry every
    # key that file carried. wifi_enable writes the same path for wlan0, and
    # omitting [Link] here silently dropped its RequiredForOnline=no - after
    # which a radio that could not associate held network-online.target until
    # timeout on every boot, with docker and Portainer queued behind it.
    local rfo
    rfo="$(required_for_online "$iface")"
    case "$mode" in
        dhcp)
            info "Configuring $iface for DHCP"
            cat > "$dropin" <<EOF
# Auto-generated by bgrpiimage-setup - change via "$PROG ip" or remove for defaults.
[Match]
Name=$iface

[Network]
DHCP=ipv4
IPv6AcceptRA=yes
LinkLocalAddressing=ipv6

[Link]
RequiredForOnline=$rfo
EOF
            ;;
        static)
            # ${5-...} rather than ${5:-...}: an explicitly empty argument now
            # means "write no DNS= at all", which an isolated plant LAN with no
            # resolver needs. ${5:-} would have forced 1.1.1.1 back in.
            local cidr="${3:-}" gw="${4:-}" dns="${5-1.1.1.1}" d
            is_ipv4_cidr "$cidr" || die "CIDR must be a valid IPv4 address and prefix, e.g. 10.0.0.5/24"
            [[ -z "$gw" ]] || is_ipv4 "$gw" || die "gateway '$gw' is not a valid IPv4 address"
            for d in ${dns//,/ }; do
                is_ipv4 "$d" || die "DNS '$d' is not a valid IPv4 address"
            done
            info "Configuring $iface static $cidr${gw:+ via $gw} (DNS $dns)"
            {
                echo "# Auto-generated by bgrpiimage-setup"
                echo "[Match]"
                echo "Name=$iface"
                echo
                echo "[Network]"
                echo "Address=$cidr"
                [[ -n "$gw" ]] && echo "Gateway=$gw"
                [[ -z "$dns" ]] || echo "DNS=${dns//,/ }"
                echo "IPv6AcceptRA=yes"
                echo
                echo "[Link]"
                echo "RequiredForOnline=$rfo"
            } > "$dropin"
            ;;
        *)
            die "unknown mode '$mode' (expected: dhcp | static)"
            ;;
    esac
    chmod 644 "$dropin"
    info "reloading systemd-networkd"
    networkctl reload
    networkctl reconfigure "$iface" 2>/dev/null || systemctl restart systemd-networkd
    ok "$iface reconfigured; inspect with: networkctl status $iface"
}

# --------------------------------------------------------------------------
# `systemctl is-active` PRINTS the state and still exits non-zero for every
# state that is not "active", so `$(... || echo inactive)` captured BOTH words
# and printed a second, unindented "inactive" line underneath - on every image,
# since wifi ships off.
svc_state() {
    local st
    st="$(systemctl is-active "$1" 2>/dev/null || true)"
    echo "${st:-unknown}"
}

cmd_status() {
    if [[ -r /etc/bgrpiimage-release ]]; then
        # shellcheck disable=SC1091
        . /etc/bgrpiimage-release
        echo "${CY}bgRPIImage${NC} ${GR}${BGRPIIMAGE_VARIANT:-?}${NC} v${BGRPIIMAGE_VERSION:-?}"
    fi
    echo "${CY}host:${NC} $(hostname)"
    echo
    # `cmd | head -N` returns non-zero under pipefail as soon as head exits
    # early and the writer dies of SIGPIPE, so this fallback fired on SUCCESS
    # and appended a whole `ip -br addr` table under the networkctl block it
    # was meant to replace. Decide on networkctl's own status, then truncate.
    local netstat
    if netstat="$(networkctl status --no-pager 2>/dev/null)"; then
        printf '%s\n' "$netstat" | head -30
    else
        ip -br addr
    fi
    echo
    echo "${CY}can:${NC}"
    can_status
    echo
    echo "${CY}radios:${NC}"
    echo "  bluetooth: $(svc_state bluetooth)"
    echo "  wifi:      $(svc_state wpa_supplicant@wlan0.service)"
    rfkill list 2>/dev/null | sed 's|^|  |' || true
    echo
    # Both file types, on purpose: .network is networkd's, .link is udev's,
    # and listing only the former hid the file that owns TransmitQueueLength.
    # Split by origin: 05-bgrpiimage-* is what THIS tool writes, everything
    # else was shipped in the image. Listing them together under one
    # "drop-ins" heading told an operator nothing about what they had actually
    # overridden - which is the whole question when a setting looks wrong.
    echo "${CY}your overrides:${NC}"
    ls -1 /etc/systemd/network/05-bgrpiimage-* 2>/dev/null | sed 's|^|  |' || echo "  (none)"
    echo "${CY}image defaults:${NC}"
    ls -1 /etc/systemd/network/*.network /etc/systemd/network/*.link 2>/dev/null \
        | grep -v '/05-bgrpiimage-' | sed 's|^|  |' || echo "  (none)"
}

# --------------------------------------------------------------------------
case "${1:-}" in
    password|pw)      shift; cmd_password "$@" ;;
    wifi)             shift; cmd_wifi "$@" ;;
    can)              shift; cmd_can "$@" ;;
    ip|network)       shift; cmd_ip "$@" ;;
    status|info)      shift; cmd_status "$@" ;;
    -h|--help|help|"") usage 0 ;;
    # Name the offending word before dumping help. Printing bare usage made an
    # unknown subcommand indistinguishable from `--help`, so a user on an older
    # image reads "can" missing from the list as the docs being wrong rather
    # than their image being older. $1 is safe under `set -u`: the empty case
    # is caught by the arm above.
    *)                echo "$PROG: unknown command '$1'" >&2; usage 2 ;;
esac
