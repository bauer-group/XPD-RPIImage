#!/usr/bin/env bash
# bgrpiimage-setup - on-device helper for the most common post-flash changes.
# Installed at /usr/local/sbin/bgrpiimage-setup. Always run with sudo.
#
# Subcommands:
#   password [USER]                        change a user's password (default: admin)
#   wifi enable SSID [PSK] [COUNTRY]       unblock the radio and join a network
#   wifi disable                           tear wifi down and drop its stored PSK
#   wifi status                            rfkill state, regulatory domain, link
#   can status                             per interface: chip select, IRQ, bitrate
#   can bitrate IFACE BPS                  change a CAN bitrate (persistent)
#   can txqueuelen IFACE LEN               change a CAN tx queue length (persistent)
#   ip IFACE dhcp                          switch an interface to DHCP
#   ip IFACE static CIDR [GATEWAY] [DNS]   assign a static IPv4 (CIDR = addr/prefix)
#   status                                 show current network + identity
#
# Images ship with WiFi off: no wlan0 .network file, no wpa_supplicant config.
# "wifi enable" creates both and lifts the rfkill soft block that Raspberry Pi
# OS applies to every radio until a regulatory domain is set. Bluetooth is
# unblocked by the image itself and is not touched by these commands.
#
# Network changes are written as a separate .network file that sorts before
# the image defaults, so they win without those defaults being edited or
# removed. Delete that file to fall back to the shipped configuration.
set -euo pipefail

PROG="${0##*/}"
[[ "$EUID" -eq 0 ]] || { echo "$PROG must run as root (use sudo)" >&2; exit 1; }

CY=$'\033[1;36m'; GR=$'\033[1;32m'; YE=$'\033[1;33m'; RD=$'\033[1;31m'; NC=$'\033[0m'
[[ -t 1 ]] || { CY=''; GR=''; YE=''; RD=''; NC=''; }

RFKILL_CONF=/etc/modprobe.d/zz-bgrpiimage-rfkill.conf
WPA_CONF=/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
MARKER=/etc/bgrpiimage-default-password-active

info()  { echo "${CY}[*]${NC} $*"; }
ok()    { echo "${GR}[+]${NC} $*"; }
warn()  { echo "${YE}[!]${NC} $*" >&2; }
die()   { echo "${RD}[x]${NC} $*" >&2; exit 1; }

usage() {
    # Print the leading comment block instead of a hardcoded line range. The
    # previous `sed -n '2,18p'` silently truncated the help text every time a
    # subcommand was documented below line 18.
    awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"
    exit "${1:-0}"
}

# --------------------------------------------------------------------------
cmd_password() {
    local user="${1:-admin}"
    id -u "$user" >/dev/null 2>&1 || die "user '$user' does not exist"
    info "Changing password for '$user'"
    passwd "$user"
    # Clear only THIS user's marker line. Removing the whole file silenced the
    # MOTD warning for every other account that still carried a default.
    if [[ -f "$MARKER" ]]; then
        sed -i "/^${user}:/d; /^${user}$/d" "$MARKER"
        [[ -s "$MARKER" ]] || rm -f "$MARKER"
    fi
    ok "password updated for $user"
}

# --------------------------------------------------------------------------
# Raspberry Pi OS soft-blocks EVERY radio at rfkill module init, through
# /etc/modprobe.d/rfkill_default.conf (options rfkill default_state=0), until a
# WLAN regulatory domain is configured. wpa_supplicant's own country= cannot
# lift it: "ip link set wlan0 up" returns -ERFKILL before wpa_supplicant ever
# gets to send a regulatory hint.
wifi_unblock() {
    local country="$1" f
    install -d /etc/modprobe.d
    cat > "$RFKILL_CONF" <<EOF
# bgRPIImage - overrides raspberrypi-sys-mods' rfkill_default.conf, which is a
# dpkg conffile and must not be edited in place. modprobe reads this directory
# in lexicographic order and the kernel keeps the last value, hence the zz-.
options rfkill default_state=1
options cfg80211 ieee80211_regdom=$country
EOF
    chmod 644 "$RFKILL_CONF"
    if command -v rfkill >/dev/null 2>&1; then
        rfkill unblock wifi || true
    fi
    # systemd-rfkill restores a saved block on the next boot. Clear WLAN only:
    # the *:bluetooth entries are pi-gen's Bluetooth whitelist against
    # default_state=0, and deleting those soft-blocks Bluetooth on CM4.
    for f in /var/lib/systemd/rfkill/*:wlan; do
        if [[ -e "$f" ]]; then echo 0 > "$f"; fi
    done
    iw reg set "$country" 2>/dev/null || true
}

wifi_enable() {
    local ssid="${1:-}" psk="${2:-}" country="${3:-DE}"
    [[ -n "$ssid" ]] || die "usage: $PROG wifi enable SSID [PSK] [COUNTRY]"
    if [[ -z "$psk" ]]; then
        read -r -s -p "WiFi password for \"$ssid\": " psk; echo
        [[ -n "$psk" ]] || die "empty password"
    fi

    info "Lifting the rfkill soft block (regulatory domain $country)"
    wifi_unblock "$country"

    info "Writing $WPA_CONF"
    install -d -m 755 /etc/wpa_supplicant
    {
        echo "ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev"
        echo "update_config=1"
        echo "country=$country"
        echo
        # wpa_passphrase hashes the PSK; drop its plaintext comment line.
        wpa_passphrase "$ssid" "$psk" | grep -v '^[[:space:]]*#psk='
    } > "$WPA_CONF.tmp"
    install -m 600 "$WPA_CONF.tmp" "$WPA_CONF"
    rm -f "$WPA_CONF.tmp"

    # RequiredForOnline=no is load bearing: without it a wlan0 that cannot
    # associate blocks systemd-networkd-wait-online, and docker.service plus
    # the Portainer first-boot install queue behind network-online.target.
    local dropin="/etc/systemd/network/05-bgrpiimage-wlan0.network"
    info "Writing $dropin"
    cat > "$dropin" <<'EOF'
# Auto-generated by bgrpiimage-setup - remove to hand wlan0 back to the image.
[Match]
Name=wlan0

[Network]
DHCP=ipv4
IPv6AcceptRA=yes
LinkLocalAddressing=ipv6

[Link]
RequiredForOnline=no
EOF
    chmod 644 "$dropin"

    systemctl enable "wpa_supplicant@wlan0.service" >/dev/null 2>&1 || true
    systemctl restart "wpa_supplicant@wlan0.service"
    networkctl reload 2>/dev/null || systemctl restart systemd-networkd
    ok "wifi enabled (SSID=$ssid, country=$country)"
    info "check with: $PROG wifi status"
}

wifi_disable() {
    info "Disabling wlan0"
    systemctl disable --now "wpa_supplicant@wlan0.service" 2>/dev/null || true
    rm -f "$WPA_CONF" /etc/systemd/network/05-bgrpiimage-wlan0.network
    networkctl reload 2>/dev/null || systemctl restart systemd-networkd
    ip link set wlan0 down 2>/dev/null || true
    ok "wlan0 down; wpa_supplicant config and stored PSK removed"
    if [[ -f /etc/systemd/network/20-wlan.network ]]; then
        warn "image default /etc/systemd/network/20-wlan.network is still present"
        warn "  (pre-0.6.0 image) - delete it to make wlan0 fully unmanaged"
    fi
    info "Bluetooth is unaffected; the rfkill override stays in place"
}

wifi_status() {
    echo "${CY}rfkill:${NC}"
    rfkill list 2>/dev/null | sed 's|^|  |' || echo "  (rfkill not available)"
    echo "${CY}regulatory domain:${NC}"
    iw reg get 2>/dev/null | sed -n '1,3p' | sed 's|^|  |' || echo "  (unknown)"
    echo "${CY}rfkill default_state:${NC} $(cat /sys/module/rfkill/parameters/default_state 2>/dev/null || echo '?')"
    echo "${CY}wpa_supplicant@wlan0:${NC} $(systemctl is-active wpa_supplicant@wlan0.service 2>/dev/null || echo inactive)"
    echo "${CY}link:${NC}"
    ip -br addr show wlan0 2>/dev/null | sed 's|^|  |' || echo "  (no wlan0)"
}

cmd_wifi() {
    case "${1:-status}" in
        enable)            shift; wifi_enable "$@" ;;
        disable|--disable) wifi_disable ;;
        status)            wifi_status ;;
        -h|--help)         usage 0 ;;
        # Back-compat with the pre-0.6.0 form: wifi SSID [PSK] [COUNTRY].
        *)                 wifi_enable "$@" ;;
    esac
}

# --------------------------------------------------------------------------
# The mcp251x driver names netdevs "can%d" in probe order, so the interface
# number says nothing about which physical connector it is - the chip select
# does, and can0 must resolve to spi0.0. The IRQ is registered under
# dev_name(&spi->dev), i.e. "spi0.0", never "mcp251x", and only from ndo_open,
# so a link that is down shows no IRQ line at all.
can_status() {
    local iface cs irq_line gpio trig count rate state qlen found=0
    for iface in $(ls /sys/class/net 2>/dev/null | grep '^can[0-9]' | sort); do
        found=1
        cs=$(basename "$(readlink -f "/sys/class/net/$iface/device" 2>/dev/null)" 2>/dev/null)
        [[ -n "$cs" ]] || cs="?"
        irq_line=$(awk -v d="$cs" '$NF==d {
            n=0; for (i=2; i<=NF-4; i++) n+=$i;
            print $(NF-2), $(NF-1), n; exit
        }' /proc/interrupts 2>/dev/null)
        if [[ -n "$irq_line" ]]; then
            gpio=$(echo "$irq_line" | awk '{print $1}')
            trig=$(echo "$irq_line" | awk '{print $2}')
            count=$(echo "$irq_line" | awk '{print $3}')
        else
            gpio="-"; trig="-"; count="-"
        fi
        rate=$(ip -details link show "$iface" 2>/dev/null | grep -oE 'bitrate [0-9]+' | awk '{print $2}')
        if [[ -n "$rate" ]]; then rate="$((rate / 1000)) kbit/s"; else rate="(down)"; fi
        state=$(ip -br link show "$iface" 2>/dev/null | awk '{print $2}')
        qlen=$(cat "/sys/class/net/$iface/tx_queue_len" 2>/dev/null || echo "?")
        printf "  %-6s %-8s gpio %-4s %-6s irq %-12s %-12s %-9s txq %s\n" \
            "$iface" "$cs" "$gpio" "$trig" "$count" "$rate" "${state:-?}" "$qlen"
        ip -details -statistics link show "$iface" 2>/dev/null \
            | grep -E 'can state|re-started|bus-error' | sed 's|^|         |' || true
    done
    if [[ "$found" -eq 0 ]]; then
        echo "  (no CAN interfaces)"
        return 0
    fi
    echo
    echo "  ${CY}expected:${NC} can0 -> spi0.0, can1 -> spi0.1"
    echo "  A txq of 10 is the CAN core default from can_setup() - it means the"
    echo "  70-<iface>.link file never reached udev. TransmitQueueLength is a"
    echo "  .link key; in a .network file it is parsed, logged and discarded."
    echo "  An idle IRQ counter that keeps climbing means the overlay points at a"
    echo "  GPIO the HAT does not drive; a counter stuck at 0 while traffic flows"
    echo "  means it points at the other chip."
}

can_bitrate() {
    local iface="${1:-}" bps="${2:-}"
    [[ -n "$iface" && -n "$bps" ]] || die "usage: $PROG can bitrate IFACE BPS"
    [[ "$bps" =~ ^[0-9]+$ ]] || die "bitrate must be bit/s as a number, e.g. 250000"
    ip link show "$iface" >/dev/null 2>&1 || die "interface '$iface' does not exist"

    # Queue length is deliberately NOT written here. It is a .link key owned
    # by udev (see can_txqueuelen); this used to read the live tx_queue_len
    # back out of sysfs and re-persist it, which could only ever freeze
    # whatever was already in effect - including the broken default of 10.
    local dropin="/etc/systemd/network/05-bgrpiimage-${iface}.network"
    info "Writing $dropin"
    cat > "$dropin" <<EOF
# Auto-generated by bgrpiimage-setup - remove to fall back to the image default.
[Match]
Name=$iface

[CAN]
BitRate=$bps

[Link]
RequiredForOnline=no
EOF
    chmod 644 "$dropin"
    networkctl reload
    # A CAN bitrate can only be set while the link is down; networkd does that
    # itself on reconfigure. Reboot if the interface refuses to come back up.
    networkctl reconfigure "$iface" 2>/dev/null || systemctl restart systemd-networkd
    ok "$iface bitrate set to $bps bit/s"
    info "verify with: $PROG can status"
}

# TransmitQueueLength is a .link key, applied by systemd-udevd when the netdev
# appears - systemd-networkd never looks at it, so it cannot live in the
# .network drop-in above. The image ships 70-<iface>.link; a 05- prefix sorts
# ahead of that and the FIRST matching .link file wins, mirroring the .network
# override convention used elsewhere in this script.
can_txqueuelen() {
    local iface="${1:-}" len="${2:-}"
    [[ -n "$iface" && -n "$len" ]] || die "usage: $PROG can txqueuelen IFACE LEN"
    # systemd accepts 0-4294967294; cap the digit count first so the shell
    # arithmetic below cannot overflow on absurd input.
    [[ "$len" =~ ^[0-9]+$ && ${#len} -le 10 ]] && (( len <= 4294967294 )) \
        || die "txqueuelen must be an integer in 0-4294967294"
    ip link show "$iface" >/dev/null 2>&1 || die "interface '$iface' does not exist"

    local dropin="/etc/systemd/network/05-bgrpiimage-${iface}.link"
    info "Writing $dropin"
    cat > "$dropin" <<EOF
# Auto-generated by bgrpiimage-setup - remove to fall back to the image default.
[Match]
OriginalName=$iface

[Link]
TransmitQueueLength=$len
EOF
    chmod 644 "$dropin"
    # udev reads .link files only on a netdev "add" event, so the file alone
    # changes nothing until the next boot. Reload for later, then set the live
    # link directly - IFLA_TXQLEN can be written while the interface is up.
    udevadm control --reload
    ip link set dev "$iface" txqueuelen "$len"
    ok "$iface txqueuelen set to $len (now and on every boot)"
    info "verify with: $PROG can status"
}

cmd_can() {
    case "${1:-status}" in
        status)     can_status ;;
        bitrate)    shift; can_bitrate "$@" ;;
        txqueuelen) shift; can_txqueuelen "$@" ;;
        -h|--help)  usage 0 ;;
        *)          die "unknown can subcommand '${1}' (expected: status | bitrate | txqueuelen)" ;;
    esac
}

# --------------------------------------------------------------------------
cmd_ip() {
    local iface="${1:-}" mode="${2:-}"
    [[ -n "$iface" && -n "$mode" ]] || die "usage: $PROG ip IFACE {dhcp|static CIDR [GW] [DNS]}"
    ip link show "$iface" >/dev/null 2>&1 || die "interface '$iface' does not exist"

    # Must sort BEFORE the image defaults (10-eth.network, 20-wlan.network):
    # systemd-networkd applies only the FIRST .network file whose [Match]
    # matches, in lexicographic order. A 50- prefix loses to 10-/20- and is
    # silently ignored for exactly the interfaces this command targets.
    local dropin="/etc/systemd/network/05-bgrpiimage-${iface}.network"
    case "$mode" in
        dhcp)
            info "Configuring $iface for DHCP"
            cat > "$dropin" <<EOF
# Auto-generated by bgrpiimage-setup - change via "$PROG ip" or remove for defaults.
[Match]
Name=$iface

[Network]
DHCP=ipv4
IPv6AcceptRA=yes
LinkLocalAddressing=ipv6
EOF
            ;;
        static)
            local cidr="${3:-}" gw="${4:-}" dns="${5:-1.1.1.1}"
            [[ "$cidr" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$ ]] \
                || die "CIDR must look like 10.0.0.5/24"
            info "Configuring $iface static $cidr${gw:+ via $gw} (DNS $dns)"
            {
                echo "# Auto-generated by bgrpiimage-setup"
                echo "[Match]"
                echo "Name=$iface"
                echo
                echo "[Network]"
                echo "Address=$cidr"
                [[ -n "$gw" ]] && echo "Gateway=$gw"
                echo "DNS=$dns"
                echo "IPv6AcceptRA=yes"
            } > "$dropin"
            ;;
        *)
            die "unknown mode '$mode' (expected: dhcp | static)"
            ;;
    esac
    chmod 644 "$dropin"
    info "reloading systemd-networkd"
    networkctl reload
    networkctl reconfigure "$iface" 2>/dev/null || systemctl restart systemd-networkd
    ok "$iface reconfigured; inspect with: networkctl status $iface"
}

# --------------------------------------------------------------------------
cmd_status() {
    if [[ -r /etc/bgrpiimage-release ]]; then
        # shellcheck disable=SC1091
        . /etc/bgrpiimage-release
        echo "${CY}bgRPIImage${NC} ${GR}${BGRPIIMAGE_VARIANT:-?}${NC} v${BGRPIIMAGE_VERSION:-?}"
    fi
    echo "${CY}host:${NC} $(hostname)"
    echo
    networkctl status --no-pager 2>/dev/null | head -30 || ip -br addr
    echo
    echo "${CY}can:${NC}"
    can_status
    echo
    echo "${CY}radios:${NC}"
    echo "  bluetooth: $(systemctl is-active bluetooth 2>/dev/null || echo inactive)"
    echo "  wifi:      $(systemctl is-active wpa_supplicant@wlan0.service 2>/dev/null || echo inactive)"
    rfkill list 2>/dev/null | sed 's|^|  |' || true
    echo
    # Both file types, on purpose: .network is networkd's, .link is udev's,
    # and listing only the former hid the file that owns TransmitQueueLength.
    echo "${CY}network drop-ins:${NC}"
    ls -1 /etc/systemd/network/*.network 2>/dev/null | sed 's|^|  |' || echo "  (none)"
    echo "${CY}link drop-ins (udev):${NC}"
    ls -1 /etc/systemd/network/*.link 2>/dev/null | sed 's|^|  |' || echo "  (none)"
}

# --------------------------------------------------------------------------
case "${1:-}" in
    password|pw)      shift; cmd_password "$@" ;;
    wifi)             shift; cmd_wifi "$@" ;;
    can)              shift; cmd_can "$@" ;;
    ip|network)       shift; cmd_ip "$@" ;;
    status|info)      shift; cmd_status "$@" ;;
    -h|--help|help|"") usage 0 ;;
    *)                usage 2 ;;
esac
