#!/usr/bin/env bash
# bgrpiimage-update - apply a published configuration release to this device.
# Installed at /usr/local/sbin/bgrpiimage-update. Always run with sudo.
#
# Subcommands:
#   check                       is a newer configuration published?
#   plan                        download, verify, and list what would change
#   apply                       do it
#   status                      what this device is running, and what is pending
#   rollback                    restore the files the last apply replaced
#   history                     previous applies
#
# Options:
#   --version X.Y.Z             pin a release (also the way back to an older one)
#   --file BUNDLE.tar.gz        apply a local bundle - air-gapped, or a canary
#   --yes                       do not prompt
#   --allow-interrupt=LIST      permit brief loss of: network, can
#   --reapply                   re-apply the version already installed
#
# WHAT THIS DOES AND DOES NOT DO
#
# It replaces the files this project generates: systemd units, the config.txt
# fence, the MOTD and banners, CAN and network configuration. That is where
# roughly 65% of releases live.
#
# It does NOT touch users, passwords, sudoers, PAM or sshd - those are
# provisioning, not configuration, and an update that gets them wrong costs a
# site visit with an rpiboot jumper. It does not install packages either;
# unattended-upgrades owns that job, with a maintenance window and a reboot
# policy this must not duplicate or pre-empt. A base OS change is refused
# outright: that is a reflash.
#
# WHY IT REFUSES SO MUCH
#
# The refusals are the product. A config that lands but does not take effect
# is this project's recurring failure - SamplePoint without a % sign, a
# TransmitQueueLength in the wrong file type, RestartSec read as seconds. Each
# parsed cleanly and did nothing. So every check here asks about EFFECT, and
# anything it cannot establish stops the transaction rather than proceeding
# hopefully.
set -euo pipefail

PROG="${0##*/}"
[[ "$EUID" -eq 0 ]] || { echo "$PROG must run as root (use sudo)" >&2; exit 1; }

CY=$'\033[1;36m'; GR=$'\033[1;32m'; YE=$'\033[1;33m'; RD=$'\033[1;31m'; NC=$'\033[0m'
[[ -t 1 ]] || { CY=''; GR=''; YE=''; RD=''; NC=''; }
# Progress goes to stderr, not stdout. Several functions here return a value
# by echoing it - the extracted bundle directory, a resolved version - and a
# status line sharing that channel gets captured by the caller's command
# substitution and becomes part of the "value". That bug has now appeared
# twice, in download_bundle and in verify_signature; separating the channels
# retires the whole class instead of the two instances. Real output - status,
# history - still goes to stdout, which is what a pipeline would want.
info() { echo "${CY}[*]${NC} $*" >&2; }
ok()   { echo "${GR}[+]${NC} $*" >&2; }
warn() { echo "${YE}[!]${NC} $*" >&2; }
die()  { echo "${RD}[x]${NC} $*" >&2; exit 1; }

usage() {
    awk 'NR==1 {next} /^#/ {sub(/^# ?/, ""); print; next} {exit}' "$0"
    exit "${1:-0}"
}

RELEASE=/etc/bgrpiimage-release
APPLIED=/etc/bgrpiimage-applied
STATE=/var/lib/bgrpiimage
WORK="$STATE/update"
ROLLBACK="$STATE/rollback"
LOCK="$STATE/update.lock"
PENDING="$STATE/update-pending-verify"
TRUSTED_KEYS=/usr/share/bgrpiimage/trusted-keys.d

UPDATE_REPO="${BGRPIIMAGE_UPDATE_REPO:-bauer-group/XPD-RPIImage}"
UPDATE_API="${BGRPIIMAGE_UPDATE_API:-https://api.github.com}"
UPDATE_DL="${BGRPIIMAGE_UPDATE_DL:-https://github.com}"

SUPPORTED_BUNDLE_FORMAT=1
MIN_BUNDLE_FORMAT=1

OPT_VERSION=""; OPT_FILE=""; OPT_YES=0; OPT_REAPPLY=0
OPT_INTERRUPT=""

fetch() {
    curl --proto '=https' --tlsv1.2 -fsSL \
         --connect-timeout 15 --max-time 300 --max-filesize 8388608 "$@"
}

# ---------------------------------------------------------------------------
# Device identity
# ---------------------------------------------------------------------------
load_identity() {
    [[ -r "$RELEASE" ]] || die "$RELEASE missing - this is not a bgRPIImage device"
    # shellcheck disable=SC1090
    . "$RELEASE"
    IMAGE_VERSION="${BGRPIIMAGE_VERSION:-}"
    VARIANT="${BGRPIIMAGE_VARIANT:-}"
    BASE_SHA="${BGRPIIMAGE_BASE_IMAGE_SHA256:-}"
    CONTRACT="${BGRPIIMAGE_APPLY_CONTRACT:-0}"
    CONFIG_VERSION=""
    if [[ -r "$APPLIED" ]]; then
        # shellcheck disable=SC1090
        CONFIG_VERSION=$( . "$APPLIED" 2>/dev/null && printf '%s' "${BGRPIIMAGE_CONFIG_VERSION:-}" )
    fi
    EFFECTIVE_VERSION="${CONFIG_VERSION:-$IMAGE_VERSION}"
}

applied_set() {
    local key="$1" val="$2"
    touch "$APPLIED"; chmod 644 "$APPLIED"
    if grep -q "^${key}=" "$APPLIED" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}='${val}'|" "$APPLIED"
    else
        printf "%s='%s'\n" "$key" "$val" >> "$APPLIED"
    fi
}

# ---------------------------------------------------------------------------
# Fetch + verify
# ---------------------------------------------------------------------------
resolve_latest() {
    command -v jq >/dev/null || die "jq is required to resolve the latest release"
    local body tag
    body=$(fetch "${UPDATE_API}/repos/${UPDATE_REPO}/releases/latest") \
        || die "could not reach ${UPDATE_API} - check DNS and outbound HTTPS"
    tag=$(printf '%s' "$body" | jq -r '.tag_name // empty')
    [[ -n "$tag" ]] || die "release API returned no tag_name"
    printf '%s' "${tag#v}"
}

# Downloads the manifest only. `check` must be able to answer without pulling
# the bundle, so a device on a metered link can ask "is there anything new"
# for a few hundred bytes.
remote_manifest() {
    local version="$1"
    fetch "${UPDATE_DL}/${UPDATE_REPO}/releases/download/v${version}/bgrpiimage-${VARIANT}-v${version}.bundle.manifest.json"
}

download_bundle() {
    local version="$1" dest="$2" base name
    base="${UPDATE_DL}/${UPDATE_REPO}/releases/download/v${version}"
    name="bgrpiimage-${VARIANT}-v${version}.confbundle.tar.gz"
    info "downloading $name"
    fetch -o "$dest/$name" "$base/$name" \
        || die "no bundle for ${VARIANT} on v${version} - that release may predate config bundles"
    fetch -o "$dest/$name.sha256" "$base/$name.sha256" \
        || die "no checksum for $name - refusing to apply an unverified bundle"
    ( cd "$dest" && sha256sum -c "$name.sha256" >/dev/null 2>&1 ) \
        || die "checksum mismatch - the download is corrupt or not what the release published"
    printf '%s' "$dest/$name"
}

# Extraction is where a hostile archive would act, so it is checked before it
# is trusted: no absolute paths, no traversal, no symlinks, no device nodes,
# nothing outside root/ and manifest.json.
extract_bundle() {
    local tarball="$1" dest="$2" bad
    bad=$(tar tzf "$tarball" | grep -vE '^(manifest\.json(\.sig)?|root/)' || true)
    [[ -z "$bad" ]] || die "bundle contains unexpected members: $(printf '%s' "$bad" | head -3 | tr '\n' ' ')"
    bad=$(tar tzf "$tarball" | grep -E '(^/|\.\.)' || true)
    [[ -z "$bad" ]] || die "bundle contains absolute or traversing paths"
    mkdir -p "$dest"
    tar xzf "$tarball" -C "$dest" --no-same-owner --no-same-permissions
    [[ -f "$dest/manifest.json" ]] || die "bundle has no manifest.json"

    # BEFORE anything reads the manifest. A SHA-256 published beside the
    # bundle proves the download was not corrupted; it proves nothing about
    # who produced it, because whoever can replace the bundle can replace the
    # checksum next to it. The signature is what makes the manifest - and
    # therefore every file hash in it - worth trusting.
    verify_signature "$dest"

    # Per-file verification against the manifest, not just the tarball hash:
    # the tar checksum proves the transfer, this proves the contents.
    local rel sha actual
    while IFS=$'\t' read -r rel sha; do
        actual=$(sha256sum "$dest/root/$rel" 2>/dev/null | cut -d' ' -f1)
        [[ "$actual" == "$sha" ]] || die "bundle file $rel does not match its manifest hash"
    done < <(jq -r '.files[] | "\(.path)\t\(.sha256)"' "$dest/manifest.json")
}

# Ed25519 over the manifest, checked with openssl - which is on every device
# already, as a dependency of ca-certificates. A signature format needing a
# package a device cannot install without an update would be circular.
#
# Any key in the trust directory may vouch for a bundle. That is what makes
# key rotation possible without a reflash: a release signed by the current key
# can ship a new public key into this directory, and the next release may be
# signed by either. Nothing is trusted that was not already on the device or
# delivered by something that was.
verify_signature() {
    local dest="$1" key ok=0 count=0
    local sig="$dest/manifest.json.sig"

    [[ -f "$sig" ]] || die "bundle is not signed.
    Releases are signed; an unsigned bundle is either older than signing or
    not from this project. Refusing to apply it."

    shopt -s nullglob
    local keys=("$TRUSTED_KEYS"/*.pub)
    shopt -u nullglob
    count=${#keys[@]}
    (( count > 0 )) || die "no trusted keys in $TRUSTED_KEYS.
    This image predates release signing. Reflash to a signed image, or
    install the project's public key there by hand if you know it."

    for key in "${keys[@]}"; do
        if openssl pkeyutl -verify -rawin -pubin -inkey "$key" \
                -sigfile "$sig" -in "$dest/manifest.json" >/dev/null 2>&1; then
            ok=1
            info "signature verified against $(basename "$key")"
            break
        fi
    done
    (( ok == 1 )) || die "signature does not match any trusted key.
    Checked $count key(s) in $TRUSTED_KEYS. The bundle was signed by
    something this device does not trust - do not apply it."
}

# ---------------------------------------------------------------------------
# Preflight: everything that can refuse, refuses before anything is written
# ---------------------------------------------------------------------------
preflight() {
    local mdir="$1"
    local m="$mdir/manifest.json"
    local b_variant b_version b_format b_base b_contract

    b_variant=$(jq -r '.variant // empty' "$m")
    b_version=$(jq -r '.version // empty' "$m")
    b_format=$(jq -r '.bundle_format // 0' "$m")
    b_base=$(jq -r '.applies_to.base_image_sha256 // empty' "$m")
    b_contract=$(jq -r '.applies_to.min_apply_contract // 0' "$m")

    [[ "$b_format" -ge "$MIN_BUNDLE_FORMAT" ]] \
        || die "bundle format $b_format is older than this updater understands"
    [[ "$b_format" -le "$SUPPORTED_BUNDLE_FORMAT" ]] \
        || die "bundle format $b_format is newer than this updater - run: $PROG self-update"

    # An image predating the identity contract carries none of the fields the
    # checks below need. Guessing is not better than saying so.
    [[ "${CONTRACT:-0}" -ge "$b_contract" ]] \
        || die "this image predates in-place updates (apply contract ${CONTRACT:-0} < $b_contract) - reflash to move up"

    [[ "$b_variant" == "$VARIANT" ]] \
        || die "bundle is for '$b_variant', this device is '$VARIANT'"

    # The line between a config update and an OS update. Empty on either side
    # means unknown, which is a warning; a known mismatch is a hard stop.
    if [[ -n "$b_base" && -n "$BASE_SHA" && "$b_base" != "$BASE_SHA" ]]; then
        die "this release rebased onto a different Raspberry Pi OS - reflash required"
    elif [[ -z "$BASE_SHA" || -z "$b_base" ]]; then
        warn "base image unknown on one side - cannot prove the OS matches"
    fi

    if [[ "$b_version" == "$EFFECTIVE_VERSION" && "$OPT_REAPPLY" -eq 0 ]]; then
        ok "already at $b_version (use --reapply to run it again)"
        exit 0
    fi

    if [[ -z "$OPT_VERSION" && -z "$OPT_FILE" ]]; then
        # Only the implicit "give me the latest" path refuses to go backwards.
        # An explicit --version is a statement of intent, and it is the way
        # back from a bad release.
        [[ "$(printf '%s\n%s\n' "$EFFECTIVE_VERSION" "$b_version" | sort -V | tail -1)" == "$b_version" ]] \
            || die "$b_version is older than the installed $EFFECTIVE_VERSION - pass --version to go back deliberately"
    fi

    [[ -f /var/run/reboot-required ]] && warn "a reboot is already pending from a package upgrade"
    if command -v dpkg >/dev/null && [[ -n "$(dpkg --audit 2>/dev/null)" ]]; then
        die "dpkg reports a broken package state - fix that before changing configuration"
    fi
    local free
    free=$(df -Pk / | awk 'NR==2{print $4}')
    [[ "${free:-0}" -ge 102400 ]] || die "less than 100 MB free on / - refusing to write"

    # Do not start while unattended-upgrades' reboot window can fire: that
    # script issues `shutdown -r +1`, and a reboot landing mid-apply is how a
    # half-written config.txt happens.
    if in_maintenance_window; then
        die "inside the unattended-upgrades maintenance window - wait, or pass --yes if you accept the overlap"
    fi

    BUNDLE_VERSION="$b_version"
}

in_maintenance_window() {
    [[ "$OPT_YES" -eq 1 ]] && return 1
    local now start end
    [[ -r /etc/systemd/system/bgrpiimage-reboot-window.timer ]] || return 1
    start=$(awk -F= '/^WINDOW_START=/{gsub(/"/,"",$2); print $2}' \
            /usr/local/sbin/bgrpiimage-reboot-window.sh 2>/dev/null || true)
    end=$(awk -F= '/^WINDOW_END=/{gsub(/"/,"",$2); print $2}' \
          /usr/local/sbin/bgrpiimage-reboot-window.sh 2>/dev/null || true)
    [[ -n "$start" && -n "$end" ]] || return 1
    now=$(date +%H:%M)
    if [[ "$start" < "$end" ]]; then
        [[ "$now" > "$start" || "$now" == "$start" ]] && [[ "$now" < "$end" ]]
    else
        [[ "$now" > "$start" || "$now" == "$start" || "$now" < "$end" ]]
    fi
}

# ---------------------------------------------------------------------------
# The 05- shadowing check
# ---------------------------------------------------------------------------
# bgrpiimage-setup writes operator overrides as 05-bgrpiimage-<iface>.network,
# which sort BEFORE the shipped file and therefore REPLACE it - systemd applies
# the first matching .network and ignores every later one. So a release that
# adds a key to 40-can0.network cannot reach an interface the operator has
# overridden, and nothing warns: the file lands correctly, the key is simply
# never read.
#
# This is not hypothetical. RestartSec only entered the helper's override in
# v0.7.3, so a device where someone ran `can bitrate` on an older helper
# carries an override with no RestartSec at all - restart-ms 0, a bus-off that
# puts the MCP2515 to sleep, and an on-site visit. The devices the fix exists
# for are exactly the devices it cannot reach.
#
# Refusing is the right answer for v1: a silent partial apply is worse than a
# blocked one, and the operator is at a keyboard right now.
check_shadowing() {
    local mdir="$1" ov iface newfile lost=0
    shopt -s nullglob
    for ov in /etc/systemd/network/05-bgrpiimage-*.network \
              /etc/systemd/network/05-bgrpiimage-*.link; do
        iface=$(basename "$ov"); iface=${iface#05-bgrpiimage-}; iface=${iface%.*}
        # Which shipped file does this override displace?
        for newfile in "$mdir"/root/etc/systemd/network/*"$iface".* \
                       "$mdir"/root/opt/bgrpiimage/*/systemd-networkd/*"$iface".*; do
            [[ -f "$newfile" ]] || continue
            [[ "${newfile##*.}" == "${ov##*.}" ]] || continue
            local missing
            missing=$(comm -23 \
                <(grep -oE '^[A-Za-z]+=' "$newfile" | sort -u) \
                <(grep -oE '^[A-Za-z]+=' "$ov" | sort -u) | tr -d '=' | tr '\n' ' ')
            if [[ -n "${missing// /}" ]]; then
                warn "$ov shadows $(basename "$newfile") and lacks: ${missing}"
                lost=1
            fi
        done
    done
    shopt -u nullglob
    if [[ "$lost" -eq 1 ]]; then
        echo >&2
        die "your overrides would silently discard settings this release adds.
    Remove the override to take the shipped defaults:
        sudo rm /etc/systemd/network/05-bgrpiimage-<iface>.network
    or re-create it after the update so it carries the new keys."
    fi
}

# ---------------------------------------------------------------------------
# Snapshot + rollback
# ---------------------------------------------------------------------------
snapshot() {
    local mdir="$1" stamp tarball list
    stamp=$(date -u +%Y%m%dT%H%M%SZ)
    mkdir -p "$ROLLBACK"
    tarball="$ROLLBACK/${EFFECTIVE_VERSION}-${stamp}.tar.gz"
    list=$(mktemp)
    # Snapshot exactly the destinations this bundle can touch, in their
    # current state - not the whole filesystem. Kilobytes, and restoring it
    # cannot do collateral damage.
    ( cd "$mdir/root" && find . -type f -printf '/%P\n' ) | while read -r p; do
        [[ -f "$p" ]] && printf '%s\n' "${p#/}"
    done > "$list"
    for extra in etc/bgrpiimage-release etc/bgrpiimage-applied boot/firmware/config.txt; do
        [[ -f "/$extra" ]] && printf '%s\n' "$extra" >> "$list"
    done
    if [[ -s "$list" ]]; then
        tar czf "$tarball" -C / -T "$list" 2>/dev/null || true
        ok "snapshot: $tarball ($(du -h "$tarball" | cut -f1))"
    fi
    rm -f "$list"
    printf '%s' "$tarball" > "$STATE/last-rollback"
    # Keep the three most recent and no more: these are for the next few
    # minutes, not an archive.
    ls -1t "$ROLLBACK"/*.tar.gz 2>/dev/null | tail -n +4 | xargs -r rm -f
}

do_rollback() {
    local tarball
    tarball=$(cat "$STATE/last-rollback" 2>/dev/null || true)
    [[ -n "$tarball" && -f "$tarball" ]] || die "no snapshot to roll back to"
    info "restoring $tarball"
    tar xzf "$tarball" -C / --no-same-owner
    systemctl daemon-reload 2>/dev/null || true
    applied_set BGRPIIMAGE_CONFIG_RESULT "rolled-back"
    ok "restored. A reboot may be needed if config.txt was part of it."
}

# ---------------------------------------------------------------------------
# Apply
# ---------------------------------------------------------------------------
install_payload() {
    # The updater's own `unpack`, in two halves that are deliberately not the
    # same thing.
    #
    # /opt/bgrpiimage is INERT: nothing on a running device reads it, so
    # refreshing it changes no behaviour and an interruption here leaves the
    # device exactly as it was. `plan` therefore does this and stops - which
    # is what lets a dry run compare the new payload against the live system
    # without writing a single byte outside /opt.
    #
    # Everything else in the bundle - the two helpers - lands at a real path,
    # so it goes through the same denylist the modules are held to rather
    # than a raw tar extract that would bypass every guard in the library.
    local mdir="$1" mode="${2:-payload}" f dest
    ( cd "$mdir/root" && tar cf - opt ) | ( cd / && tar xf - )
    find /opt/bgrpiimage -name '*.sh' -exec chmod 0755 {} + 2>/dev/null || true
    [[ "$mode" == "full" ]] || return 0

    while IFS= read -r f; do
        dest="/${f#./}"
        if denied_path "$dest"; then
            warn "bundle carries $dest, which an update may not write - skipped"
            continue
        fi
        install -D -m 0755 "$mdir/root/${f#./}" "$dest"
    done < <(cd "$mdir/root" && find . -path ./opt -prune -o -type f -print)
}

# The same list the apply library enforces, restated here because this runs
# before any module is sourced. Kept short on purpose: everything under /opt
# is handled above, so this only ever sees the helpers.
denied_path() {
    case "$1" in
        /etc/shadow|/etc/passwd|/etc/group|/etc/sudoers|/etc/sudoers.d/*|\
        /etc/pam.d/*|/etc/ssh/ssh_host_*|/home/*|/root/*|\
        /etc/hostname|/etc/hosts|/etc/resolv.conf|/etc/wpa_supplicant/*|\
        /etc/fstab|/boot/firmware/cmdline.txt|/etc/machine-id|\
        /etc/bgrpiimage-release) return 0 ;;
    esac
    return 1
}

run_modules() {
    local mdir="$1" dry="$2" m rc=0
    export BGRPI_CTX=device
    export BGRPI_DRY_RUN="$dry"
    export BGRPI_INTENTS="$STATE/intents"
    : > "$BGRPI_INTENTS"
    for m in $(jq -r '.modules[]' "$mdir/manifest.json"); do
        [[ "$m" == "bgrpiimage-common" ]] && continue
        [[ -x "/opt/bgrpiimage/$m/apply.sh" ]] || continue
        if ! "/opt/bgrpiimage/$m/apply.sh"; then
            warn "$m failed"; rc=1
        fi
    done
    return $rc
}

# Intents are executed once, at the end, in an order that puts the things
# which can drop the operator's own session last - and only with consent.
execute_intents() {
    local f="$STATE/intents" line iface
    [[ -s "$f" ]] || { ok "nothing needed reloading"; return 0; }

    if grep -qx 'daemon-reload' "$f"; then
        info "systemctl daemon-reload"; systemctl daemon-reload || true
    fi
    if grep -qx 'udev-reload' "$f"; then
        info "udevadm control --reload"; udevadm control --reload 2>/dev/null || true
    fi
    while read -r line; do
        case "$line" in
            "reload ssh")
                # reload, never restart: a restart drops nothing today but a
                # failed one leaves no sshd at all.
                sshd -t 2>/dev/null || { warn "sshd config invalid - not reloading"; continue; }
                info "reloading ssh"; systemctl reload ssh 2>/dev/null || true ;;
            "restart "*)
                if allow_interrupt "service"; then
                    info "$line"; systemctl restart ${line#restart } 2>/dev/null || true
                else
                    warn "deferred: $line (pass --allow-interrupt=service)"
                fi ;;
            "networkd-reload")
                # reload re-reads the files without touching links. Applying
                # them to an interface is a separate, consented step.
                info "networkctl reload"; networkctl reload 2>/dev/null || true ;;
            "reboot "*)
                # Hand this to the machinery that already exists rather than
                # rebooting here: bgrpiimage-reboot-window.sh watches this
                # flag, respects the configured window, and the MOTD surfaces
                # it at the next login.
                mkdir -p /var/run
                touch /var/run/reboot-required
                echo "bgrpiimage-config-${BUNDLE_VERSION}" >> /var/run/reboot-required.pkgs
                applied_set BGRPIIMAGE_CONFIG_PENDING_REBOOT "yes"
                warn "takes effect after a reboot: ${line#reboot }" ;;
        esac
    done < "$f"

    # CAN links are deliberately NOT reconfigured by default. Reconfiguring
    # takes a production control bus down for the duration, and the config.txt
    # half of any CAN change needs a reboot anyway - so deferring lets both
    # halves land together instead of leaving the device straddled between
    # old overlays and new timing.
    if allow_interrupt "can"; then
        # shellcheck disable=SC2010  # netdev names cannot contain whitespace
        for iface in $(ls /sys/class/net 2>/dev/null | grep '^can[0-9]' || true); do
            info "networkctl reconfigure $iface"
            networkctl reconfigure "$iface" 2>/dev/null || true
        done
    elif grep -q 'networkd-reload' "$f"; then
        warn "CAN interfaces keep their running configuration until reboot (--allow-interrupt=can to apply now)"
    fi
}

allow_interrupt() { [[ ",${OPT_INTERRUPT}," == *",$1,"* ]]; }

# ---------------------------------------------------------------------------
# Verification: assert on effect, never on the file
# ---------------------------------------------------------------------------
# Every config bug this project has shipped had the right bytes on disk. A
# checksum proves nothing here; only the running system can say whether a
# setting took.
verify() {
    local since="$1" problems=0 iface f

    if journalctl -u systemd-networkd --since "$since" -p warning --no-pager 2>/dev/null \
            | grep -qiE 'ignoring|invalid|failed to parse'; then
        warn "systemd-networkd logged parse warnings since the apply:"
        journalctl -u systemd-networkd --since "$since" -p warning --no-pager 2>/dev/null \
            | grep -iE 'ignoring|invalid|failed to parse' | tail -5 | sed 's/^/      /'
        problems=1
    fi

    # shellcheck disable=SC2010  # netdev names cannot contain whitespace
    for iface in $(ls /sys/class/net 2>/dev/null | grep '^can[0-9]' || true); do
        f=$(networkctl status "$iface" 2>/dev/null | awk -F': *' '/Network File:/{print $2}')
        [[ -n "$f" ]] && info "$iface uses $(basename "$f")"
    done

    while read -r unit; do
        systemd-analyze verify "$unit" >/dev/null 2>&1 \
            || { warn "systemd rejects $unit"; problems=1; }
    done < <(find /etc/systemd/system -maxdepth 1 -name 'bgrpiimage-*' -type f 2>/dev/null)

    # Every dtoverlay must have a matching .dtbo, or the next boot comes up
    # without the hardware. Cheap to check now, expensive to discover later.
    if [[ -f /boot/firmware/config.txt ]]; then
        while read -r ov; do
            [[ -f "/boot/firmware/overlays/${ov}.dtbo" ]] \
                || { warn "config.txt references overlay '$ov' with no .dtbo"; problems=1; }
        done < <(grep -oP '^dtoverlay=\K[a-zA-Z0-9_-]+' /boot/firmware/config.txt 2>/dev/null || true)
    fi

    return $problems
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
prepare() { # -> echoes the extracted bundle directory
    local version dir
    mkdir -p "$WORK"
    if [[ -n "$OPT_FILE" ]]; then
        [[ -f "$OPT_FILE" ]] || die "no such bundle: $OPT_FILE"
        dir="$WORK/local"; rm -rf "$dir"; mkdir -p "$dir"
        extract_bundle "$OPT_FILE" "$dir"
    else
        version="${OPT_VERSION:-$(resolve_latest)}"
        version="${version#v}"
        [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "not a release version: '$version'"
        dir="$WORK/$version"; rm -rf "$dir"; mkdir -p "$dir"
        local tarball
        tarball=$(download_bundle "$version" "$dir")
        extract_bundle "$tarball" "$dir"
    fi
    printf '%s' "$dir"
}

cmd_check() {
    local latest manifest remote
    latest="${OPT_VERSION:-$(resolve_latest)}"
    echo "${CY}installed:${NC} ${EFFECTIVE_VERSION}   ${CY}published:${NC} ${latest}"
    if [[ "$latest" == "$EFFECTIVE_VERSION" ]]; then
        ok "up to date"; return 0
    fi
    if manifest=$(remote_manifest "$latest" 2>/dev/null); then
        remote=$(printf '%s' "$manifest" | jq -r '.applies_to.base_image_sha256 // empty')
        if [[ -n "$remote" && -n "$BASE_SHA" && "$remote" != "$BASE_SHA" ]]; then
            warn "v$latest rebased onto a different Raspberry Pi OS - it needs a reflash, not an update"
            return 1
        fi
    fi
    warn "v$latest available - run: sudo $PROG apply"
    return 1
}

cmd_plan() {
    local dir; dir=$(prepare)
    preflight "$dir"
    check_shadowing "$dir"
    info "planning ${EFFECTIVE_VERSION} -> ${BUNDLE_VERSION}"
    install_payload "$dir" payload
    run_modules "$dir" 1 || true
    echo
    if [[ -s "$STATE/intents" ]]; then
        echo "${CY}would then:${NC}"; sed 's/^/  /' "$STATE/intents"
    else
        ok "no changes - this device already matches v${BUNDLE_VERSION}"
    fi
}

cmd_apply() {
    exec 9>"$LOCK"; flock -n 9 || die "another $PROG is already running"

    local dir since; dir=$(prepare)
    preflight "$dir"
    check_shadowing "$dir"

    if [[ "$OPT_YES" -eq 0 ]]; then
        echo "${CY}about to apply${NC} ${EFFECTIVE_VERSION} -> ${BUNDLE_VERSION} on $(hostname)"
        read -r -p "continue? [y/N] " a
        [[ "$a" =~ ^[Yy]$ ]] || die "aborted"
    fi

    snapshot "$dir"
    since=$(date '+%Y-%m-%d %H:%M:%S')

    install_payload "$dir" full
    if ! run_modules "$dir" 0; then
        warn "a module failed - rolling back"
        do_rollback
        exit 1
    fi
    execute_intents

    # The version is stamped only after verification, and only into the
    # applied-state file. /etc/bgrpiimage-release keeps describing the FLASHED
    # image forever: it is what tells a future update whether the base OS
    # moved under this device, and an updater that overwrites it destroys the
    # basis of its own next safety check.
    if verify "$since"; then
        applied_set BGRPIIMAGE_CONFIG_RESULT "ok"
    else
        applied_set BGRPIIMAGE_CONFIG_RESULT "verify-failed"
        warn "applied, but verification reported problems - see above"
    fi
    applied_set BGRPIIMAGE_CONFIG_VERSION "$BUNDLE_VERSION"
    applied_set BGRPIIMAGE_CONFIG_APPLIED_AT "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    applied_set BGRPIIMAGE_CONFIG_SOURCE "github:${UPDATE_REPO}@v${BUNDLE_VERSION}"

    # Anything deferred to a reboot is re-checked after it, because half of
    # what an update changes only takes effect then.
    if [[ -f /var/run/reboot-required ]]; then
        mkdir -p "$STATE"; : > "$PENDING"
    fi
    ok "now at configuration v${BUNDLE_VERSION}"
}

cmd_status() {
    echo "${CY}image:${NC}         v${IMAGE_VERSION}  (${VARIANT})"
    if [[ -n "$CONFIG_VERSION" ]]; then
        echo "${CY}configuration:${NC} v${CONFIG_VERSION}"
        if [[ -r "$APPLIED" ]]; then sed 's/^/  /' "$APPLIED"; fi
    else
        echo "${CY}configuration:${NC} as flashed (no update applied)"
    fi
    [[ -f /var/run/reboot-required ]] && warn "reboot pending"
    [[ -f "$PENDING" ]] && warn "post-reboot verification pending"
    true
}

cmd_history() {
    if [[ -d "$ROLLBACK" ]]; then
        echo "${CY}snapshots:${NC}"; ls -1t "$ROLLBACK"/*.tar.gz 2>/dev/null | sed 's/^/  /' || echo "  (none)"
    fi
}

# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case "$1" in
        --version)          shift; OPT_VERSION="${1:-}"; [[ -n "$OPT_VERSION" ]] || die "--version needs a value" ;;
        --file)             shift; OPT_FILE="${1:-}";    [[ -n "$OPT_FILE" ]]    || die "--file needs a path" ;;
        --yes|-y)           OPT_YES=1 ;;
        --reapply)          OPT_REAPPLY=1 ;;
        --allow-interrupt=*) OPT_INTERRUPT="${1#--allow-interrupt=}" ;;
        check|plan|apply|status|rollback|history) CMD="$1" ;;
        -h|--help|help)     usage 0 ;;
        *)                  echo "$PROG: unknown argument '$1'" >&2; usage 2 ;;
    esac
    shift
done

load_identity
case "${CMD:-}" in
    check)    cmd_check ;;
    plan)     cmd_plan ;;
    apply)    cmd_apply ;;
    status)   cmd_status ;;
    rollback) do_rollback ;;
    history)  cmd_history ;;
    *)        usage 0 ;;
esac
