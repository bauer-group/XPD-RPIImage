#!/usr/bin/env bash
# bgrpiimage-hardware: build-time adapter.
#
# The logic lives in apply.sh, which the updater also runs on a live device.
# This file is only the CustomPiOS half: source the build harness, put the
# payload in place, then hand over.
set -x
set -e
export LC_ALL=C
export DEBIAN_FRONTEND=noninteractive

source /common.sh
install_cleanup_trap

unpack /filesystem/root / root

BGRPI_CTX=image /opt/bgrpiimage/bgrpiimage-hardware/apply.sh
