#!/usr/bin/env bash
# bgrpiimage-common: deploy the shared apply library.
#
# No apply.sh of its own - there is nothing to apply. This module exists so
# that /opt/bgrpiimage/bgrpiimage-common/apply-lib.sh is in place before any
# other module's apply.sh sources it, which is why it is first in MODULES.
set -x
set -e
export LC_ALL=C

source /common.sh
install_cleanup_trap

unpack /filesystem/root / root
