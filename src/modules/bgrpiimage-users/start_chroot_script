#!/usr/bin/env bash
# bgrpiimage-users: create users, configure sudo/su, harden sshd
set -x
set -e
export LC_ALL=C
export DEBIAN_FRONTEND=noninteractive

source /common.sh
install_cleanup_trap

# Deploy this module's files from the copied /filesystem/root tree
# (CustomPiOS copies module/filesystem/ into the chroot root) to
# their real destinations under /.
unpack /filesystem/root / root

GEN=/opt/bgrpiimage/bgrpiimage-users

# Stage pam_su drop-in where the create-users script expects it.
if [[ -f "$GEN/pam_su" ]]; then
    install -m 644 "$GEN/pam_su" /tmp/_bgrpiimage_su_pam
fi

bash "$GEN/create-users.sh"
rm -f /tmp/_bgrpiimage_su_pam

# create-users.sh carries the resolved ${ADMIN_PASSWORD} in cleartext - the
# generator emits `echo <user>:<pw> | chpasswd` - and `unpack` copied it here
# with --preserve=mode, i.e. 0755. So every flashed device kept the fleet
# credential world-readable at a fixed, documented path, where any local
# account could read it. Public releases were never the problem: build.yml
# leaves ADMIN_PASSWORD unset so they carry the documented default. The
# build-time credential workflow for fleets (docs/post-flash-setup.md) was.
# The script has done its job by the time we get here and nothing else
# consumes it, so drop it rather than chmod it - a file that is not there
# cannot be read, and no future module can widen its mode back.
rm -f "$GEN/create-users.sh"

# --- stock raspios first-boot user wizard ---
# pi-gen runs `rename-user -f -s` at image export
# (RPi-Distro/pi-gen export-image/01-user-rename/01-run.sh). That enables
# userconfig.service, DISABLES getty@tty1 and drops an sshd banner drop-in, so
# the physical console gets a whiptail rename+password wizard on tty8 instead
# of a login prompt. The unit is Type=oneshot (no start timeout) and ordered
# Before=getty.target, so it blocks the boot until a human answers it.
#
# We provision our own accounts, so it must not run. Mask rather than
# `apt-get purge userconf-pi`: purging would also take rename-user and
# cancel-rename, which stay useful as manual tools.
systemctl disable userconfig.service 2>/dev/null || true
systemctl mask    userconfig.service 2>/dev/null || true
# getty@tty1 is disabled (not masked) by rename-user - enable, do not unmask.
systemctl enable  getty@tty1.service 2>/dev/null || true
rm -f  /etc/ssh/sshd_config.d/rename_user.conf
rm -f  /etc/xdg/autostart/piwiz.desktop
rm -f  /etc/sudoers.d/010_pi-nopasswd
rm -rf /var/lib/userconf-pi
rm -f  /boot/firmware/userconf /boot/firmware/userconf.txt
